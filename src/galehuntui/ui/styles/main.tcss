/* GaleHunTUI Design System */

Screen {
    background: $background;
    color: $text;
}

Header {
    height: 3;
    background: $surface;
    color: $primary;
    border-bottom: solid $border;
}

HeaderTitle {
    text-style: bold;
}

HeaderClock {
    color: $text-muted;
}

Footer {
    background: $surface;
    color: $text-muted;
    border-top: solid $border;
}

Footer > .footer-key {
    color: $primary;
    text-style: bold;
}

Footer > .footer-key.-active {
    color: $accent;
}

/* Core Components */
Button {
    min-width: 16;
    height: 3;
    padding: 0 2;
    border: solid $border;
    background: $panel;
    color: $text;
    text-style: bold;
}

Button:hover {
    border: solid $primary;
    background: $surface;
    color: $primary;
}

Button:focus {
    border: heavy $primary;
    background: $surface;
}

Button.-primary,
Button.primary {
    background: $primary;
    border: solid $primary;
    color: $background;
}

Button.-warning,
Button.warning {
    background: $warning;
    border: solid $warning;
    color: $background;
}

Button.-success,
Button.success {
    background: $success;
    border: solid $success;
    color: $background;
}

Button.-error,
Button.error {
    background: transparent;
    color: $error;
    border: solid $error;
}

Button.-disabled,
.-disabled {
    opacity: 45%;
}

Input,
Select,
TextArea {
    background: $surface;
    color: $text;
    border: solid $border;
}

Input:focus,
Select:focus,
TextArea:focus {
    border: solid $primary;
}

Input > .input--placeholder {
    color: $text-muted;
}

Checkbox {
    color: $text;
}

DataTable {
    background: $background;
    border: solid $border;
}

DataTable > .datatable--header {
    background: $surface;
    color: $primary;
    text-style: bold;
}

DataTable > .datatable--cursor {
    background: $panel;
    color: $text;
}

DataTable > .datatable--hover {
    background: $panel;
}

TabbedContent {
    border: none;
}

Tab {
    background: $surface;
    color: $text-muted;
    border-bottom: solid $border;
}

Tab.-active {
    color: $primary;
    text-style: bold;
    border-bottom: heavy $primary;
}

ScrollBar {
    background: $background;
}

ScrollBar > .scrollbar--thumb {
    background: $border;
}

/* Typography + Utility */
.section-title {
    margin-bottom: 1;
    color: $primary;
    text-style: bold;
}

.panel-title {
    color: $primary;
    text-style: bold;
}

.muted {
    color: $text-muted;
}

.bold {
    text-style: bold;
}

.shortcut-hint {
    color: $text-muted;
}

.surface-card {
    background: $surface;
    border: solid $border;
    padding: 1;
}

.controls-bar {
    height: auto;
    align: right middle;
    padding-top: 1;
}

.controls-bar Button {
    margin-left: 1;
}

/* Shared layouts */
.tools-container {
    padding: 1 2;
    layout: vertical;
    height: 100%;
}

#tools-overview {
    height: 3;
    align: left middle;
    margin-bottom: 1;
    padding: 0 1;
}

#deps-overview {
    height: 3;
    align: left middle;
    margin-bottom: 1;
    padding: 0 1;
}

#deps-overview Label:first-child {
    width: 1fr;
}

#summary-core {
    width: 1fr;
    color: $primary;
    text-style: bold;
}

#summary-optional {
    width: auto;
    color: $text-muted;
}

#summary-shortcuts {
    width: 1fr;
    text-align: right;
}

.tools-section {
    height: 1fr;
    margin-bottom: 1;
}

.profiles-container {
    height: 100%;
    layout: horizontal;
}

.profiles-sidebar {
    width: 30%;
    height: 100%;
    border-right: solid $border;
    background: $surface;
    padding: 1;
}

.profiles-content {
    width: 1fr;
    height: 100%;
    padding: 1 2;
}

.form-group {
    height: auto;
    margin-bottom: 1;
}

.form-row {
    height: auto;
    margin-bottom: 1;
}

.form-group-half {
    width: 1fr;
    height: auto;
    margin-right: 2;
}

.mr-1 {
    margin-right: 1;
}

.mt-1 {
    margin-top: 1;
}

.sidebar-btn {
    width: 100%;
    margin-top: 1;
}

#profiles-list,
#list-steps {
    height: 1fr;
    border: solid $border;
    background: $background;
    margin-bottom: 1;
}

/* Run Detail */
.run-detail-container {
    padding: 1;
}

#run-log {
    height: 100%;
    border: none;
    background: $background;
}

#findings-table {
    height: 100%;
}

/* Widget styling */
LogViewWidget {
    height: 100%;
}

LogViewWidget .log-toolbar {
    height: 3;
    background: $surface;
    border-bottom: solid $border;
    padding: 0 1;
}

LogViewWidget RichLog {
    height: 1fr;
    background: $background;
    border: solid $border;
}

PipelineProgressWidget {
    min-height: 10;
    background: $background;
    border: solid $border;
}

PipelineProgressWidget .progress-header {
    height: 3;
    background: $surface;
    border-bottom: solid $border;
    padding: 0 1;
}

PipelineProgressWidget .progress-header Label {
    color: $primary;
    text-style: bold;
}

PipelineProgressWidget .stages-header {
    background: $surface;
    padding: 0 1;
}

PipelineProgressWidget .stages-header Static {
    color: $text-muted;
    text-style: bold;
}

StageRow {
    height: 1;
    padding: 0 1;
}

StageRow:hover {
    background: $panel;
}

StageRow.completed .stage-name {
    color: $success;
}

StageRow.failed .stage-name {
    color: $error;
}

StageRow.skipped .stage-name {
    color: $text-muted;
}

FindingsTableWidget {
    height: 100%;
}

FindingsTableWidget .findings-toolbar {
    height: 3;
    background: $surface;
    border-bottom: solid $border;
    padding: 0 1;
}

FindingsTableWidget DataTable {
    height: 1fr;
}
